# Docker Compose project identity
PROJECT_NAME=laravel

# Runtime and host permissions (make init detects these values for a new .env)
PHP_VERSION=8.5
HOST_UID=1000
HOST_GID=1000

# Host ports (services remain on their default ports inside Docker)
HTTP_PORT=8080
MYSQL_PORT=3307

# Local development database credentials
MYSQL_DATABASE=laravel
MYSQL_USER=laravel
MYSQL_PASSWORD=laravel
MYSQL_ROOT_PASSWORD=laravel-root

# Set to debug to enable Xdebug for CLI and web requests.
XDEBUG_MODE=off
